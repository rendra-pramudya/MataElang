PORT=8000
FIXTURE_MODE=false
DB_PATH=./data/mataelang.sqlite
RETENTION_DAYS=90
USGS_FEED=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_hour.geojson
GDELT_LASTUPDATE_URL=http://data.gdeltproject.org/gdeltv2/lastupdate.txt
GDELT_MIN_GOLDSTEIN=-3
GDELT_MAX_EVENTS=400

# Open-Meteo: watch points, not coverage. "name,lat,lon" separated by ";".
# Severe weather is reported only where you point it — see docs/phase-1-layers.md §3.1.
OPENMETEO_URL=https://api.open-meteo.com/v1/forecast
OPENMETEO_POINTS=Jakarta,-6.21,106.85;Surabaya,-7.25,112.75;Medan,3.59,98.67;Makassar,-5.15,119.43;Banda Aceh,5.55,95.32;Jayapura,-2.53,140.72;Singapore,1.35,103.82;Manila,14.60,120.98;Tokyo,35.68,139.69;Sydney,-33.87,151.21

# RSS: ";"-separated feed URLs. Terms belong to each publisher — swap these for your own.
RSS_FEEDS=https://feeds.bbci.co.uk/news/world/rss.xml;https://www.aljazeera.com/xml/rss/all.xml;https://rss.dw.com/rdf/rss-en-world
RSS_MAX_ITEMS_PER_FEED=60

# Heat map. H3 resolution 3 is ~59 km edge; 0-7 accepted.
HEAT_DEFAULT_RESOLUTION=3
HEAT_MAX_RESOLUTION=7
HEAT_QUERY_LIMIT=10000
